# Copy this file to .env and fill in real values. Never commit .env.

# Leave DATABASE_URL unset to use the default: a SQLite file at backend/dev.db
# (no setup needed, and stable regardless of your current working directory).
# For production/PostGIS features, point this at a PostgreSQL database with
# the postgis extension enabled instead, e.g.:
# DATABASE_URL=postgresql://darukaa:darukaa@localhost:5432/darukaa_earth

SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173
